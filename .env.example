# Copie para .env.local (no computador) ou cadastre em Vercel > Project > Settings > Environment Variables.
# Nunca coloque valores reais neste arquivo.

# Obrigatória: chave da API da Anthropic (console.anthropic.com > API Keys).
# No console, defina também um limite mensal de gasto (sugestão: US$ 10).
ANTHROPIC_API_KEY=

# Opcional (recomendado): Supabase para o limite por visitante e o registro anônimo das conversas.
# Rode supabase/schema.sql no SQL Editor antes. Use a chave service_role (fica só no servidor).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Texto aleatório usado para embaralhar o IP antes de guardar (nunca guardamos o IP).
HASH_SALT=

# Mensagens por visitante por hora (padrão 20).
CHAT_LIMITE_HORA=20

# Domínios que podem chamar /api/chat, separados por vírgula (ex.: https://dalpinoclinic.com.br).
# Vazio = sem trava de origem.
ALLOWED_ORIGINS=

# Endereço definitivo do site. Depois de definir, rode: npm run definir-url
SITE_URL=https://dalpino-clinic-lp.vercel.app
